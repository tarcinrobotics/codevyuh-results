# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=codevyuh_db
PGSSLMODE=disable

# Legacy/alternative key formats supported:
# Host=localhost
# Port=5432
# User=postgres
# Password=your_password
# Database=codevyuh_db
# SSL Mode=disable

# Super Admin Default Credentials
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change_this_password

# MongoDB Configuration (User Authentication & RBAC)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codevyuh_auth?retryWrites=true&w=majority
MONGODB_DATABASE=codevyuh_auth

# Server Port
SERVER_PORT=3000
