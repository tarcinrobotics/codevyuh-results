# ═════════════════════════════════════════════════════════════════════════════
# Codevyuh Competition Platform — Production Environment Configuration
# Copy this file to .env and replace with your deployment values.
# ═════════════════════════════════════════════════════════════════════════════

# ── 1. HTTP Server ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── 2. PostgreSQL Database Connection ────────────────────────────────────────
# Option A: Full Connection String (Standard on Supabase / Neon / Render / AWS)
# DATABASE_URL=postgresql://user:password@hostname:5432/codevyuh_db?sslmode=require

# Option B: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_db_password
PGDATABASE=codevyuh_db
PGSSLMODE=disable

# ── 3. Session Security ──────────────────────────────────────────────────────
# Generate a cryptographically random string (e.g. openssl rand -hex 32)
SESSION_SECRET=your_32_character_cryptographically_secure_session_secret
SESSION_NAME=codevyuh.sid

# ── 4. Administrative Credentials (Injected at Runtime) ──────────────────────
# Passwords configured here are hashed with bcrypt (10 rounds) upon startup
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password

DOLPHIN_ADMIN_PASSWORD=your_secure_dolphin_admin_password
KLN_ADMIN_PASSWORD=your_secure_kln_admin_password

# ── 5. MongoDB (Optional - User Authentication & Session Persistence) ────────
# If omitted or offline, the platform seamlessly falls back to resilient storage
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/codevyuh_auth?retryWrites=true&w=majority
