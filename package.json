{
  "name": "Codevyuh-dashboard",
  "version": "1.0.0",
  "description": "Codevyuh-Results Analysis Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/init-database.js",
    "seed:auth": "node scripts/seed-auth-users.js",
    "seed:tournament": "node scripts/seed-tournament-scores.js",
    "db:start": "powershell -Command \"Start-Service postgresql-x64-17\"",
    "db:stop": "powershell -Command \"Stop-Service postgresql-x64-17\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "mongoose": "^9.4.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
