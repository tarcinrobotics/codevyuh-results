{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "redirects": [
    {
      "source": "/admin-overview.html",
      "destination": "/admin-overview",
      "permanent": false
    },
    {
      "source": "/zone-dashboard.html",
      "destination": "/zone-dashboard",
      "permanent": false
    },
    {
      "source": "/parent-view.html",
      "destination": "/parent-view",
      "permanent": false
    },
    {
      "source": "/student-report.html",
      "destination": "/student-report",
      "permanent": false
    },
    {
      "source": "/user-management.html",
      "destination": "/user-management",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index"
    }
  ]
}
