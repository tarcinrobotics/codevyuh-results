{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin-overview",
      "dest": "/api/index.js"
    },
    {
      "src": "/zone-dashboard",
      "dest": "/api/index.js"
    },
    {
      "src": "/parent-view",
      "dest": "/api/index.js"
    },
    {
      "src": "/student-report",
      "dest": "/api/index.js"
    },
    {
      "src": "/user-management",
      "dest": "/api/index.js"
    },
    {
      "src": "/login",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
